    b.BackgroundTransparency = 0.2
    b.Font = Enum.Font.GothamBold; b.TextSize = 14
    b.ZIndex = 21; b.Parent = FlyPad
    Instance.new("UICorner",b).CornerRadius = UDim.new(0,8)
    b.MouseButton1Down:Connect(function() b.BackgroundTransparency=0; onDown() end)
    b.MouseButton1Up:Connect(function()   b.BackgroundTransparency=0.2; onUp() end)
    -- Touch support
    b.TouchLongPress:Connect(function() end) -- prevent long press conflicts
    return b
end

