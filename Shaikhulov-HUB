-- Mobile: tap Click TP (TouchTap fires once per tap, not held)
UIS.TouchTap:Connect(function(positions, processed)
    if processed then return end
    if not F.ClickTP.on or not isMobile then return end
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local tapPos = positions[1]
    if not tapPos then return end
    local ray = camera:ScreenPointToRay(tapPos.X, tapPos.Y)
    local result = workspace:Raycast(ray.Origin, ray.Direction * 1000)
    if result then
        hrp.CFrame = CFrame.new(result.Position + Vector3.new(0,3,0))
        Notify("📍 Телепорт!", C.Accent, 1.5)
    end
end)

