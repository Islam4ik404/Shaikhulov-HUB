local function GetClosestInFOV()
    local mp = UIS:GetMouseLocation(); local closest, minD = nil, F.Aimbot.fov
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local target = plr.Character:FindFirstChild(F.Aimbot.bone) or plr.Character:FindFirstChild("HumanoidRootPart")
            if target then
                local sp, on = camera:WorldToViewportPoint(target.Position)
                if on then
                    local d = (Vector2.new(sp.X,sp.Y) - mp).Magnitude
                    if d < minD then minD=d; closest=target end
                end
            end
        end
    end
    return closest
end

