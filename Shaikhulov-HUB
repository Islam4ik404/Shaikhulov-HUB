    for plr, data in pairs(ESPLabels) do
        if not plr or not plr.Character or not plr.Character:FindFirstChild("Head") then
            if data.name then data.name.Visible=false end
            if data.dist then data.dist.Visible=false end
            continue
        end
        local head = plr.Character.Head
        local pos, onScreen = camera:WorldToViewportPoint(head.Position + Vector3.new(0,2.8,0))
        if onScreen and (F.ESP.names or F.ESP.distance) then
            if F.ESP.names and data.name then
                data.name.Text = plr.DisplayName
                data.name.Position = Vector2.new(pos.X, pos.Y)
                data.name.Visible = true
            else if data.name then data.name.Visible=false end end
            if F.ESP.distance and data.dist and myHRP then
                local dist = math.floor((head.Position - myHRP.Position).Magnitude)
                data.dist.Text = dist.."m"
                data.dist.Position = Vector2.new(pos.X, pos.Y+15)
                data.dist.Visible = true
            else if data.dist then data.dist.Visible=false end end
        else
            if data.name then data.name.Visible=false end
            if data.dist then data.dist.Visible=false end
        end
    end
end

