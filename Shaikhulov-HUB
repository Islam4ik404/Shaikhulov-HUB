local flyConn = nil

local function StartFly()
    local ch = player.Character; if not ch then return end
    local hrp = ch:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local hm = ch:FindFirstChildOfClass("Humanoid"); if not hm then return end
    hm.PlatformStand = true

    local bg = Instance.new("BodyGyro"); bg.P=9e4; bg.MaxTorque=Vector3.new(9e9,9e9,9e9)
    bg.CFrame = hrp.CFrame; bg.Parent = hrp

    local bv = Instance.new("BodyVelocity"); bv.Velocity=Vector3.zero
    bv.MaxForce = Vector3.new(9e9,9e9,9e9); bv.Parent = hrp

    -- Show fly D-pad on mobile
    if isMobile then FlyPad.Visible = true end

    flyConn = RS.Heartbeat:Connect(function()
        if not F.Fly.on then
            pcall(function() bg:Destroy(); bv:Destroy() end)
            hm.PlatformStand = false
            if isMobile then FlyPad.Visible = false end
            -- Reset all directions
            for k in pairs(flyDir) do flyDir[k] = false end
            if flyConn then flyConn:Disconnect(); flyConn=nil end
            return
        end
        local cf = camera.CFrame; local dir = Vector3.zero

        -- PC keyboard input
        if not isMobile then
            if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + cf.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - cf.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - cf.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + cf.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space)       then dir = dir + Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0,1,0) end
        else
            -- Mobile D-pad input
            if flyDir.fwd   then dir = dir + cf.LookVector end
            if flyDir.back  then dir = dir - cf.LookVector end
            if flyDir.left  then dir = dir - cf.RightVector end
            if flyDir.right then dir = dir + cf.RightVector end
            if flyDir.up    then dir = dir + Vector3.new(0,1,0) end
            if flyDir.down  then dir = dir - Vector3.new(0,1,0) end
        end

        bv.Velocity = dir.Magnitude > 0 and dir.Unit * F.Fly.val or Vector3.zero
        bg.CFrame = cf
    end)
end

-- ═══════════════════════ ULTRA FLING ══════════════════════

local flingActive = false

local function UltraFling(target)
    if flingActive then return end; flingActive = true
    local ch = player.Character; if not ch then flingActive=false; return end
    local hrp = ch:FindFirstChild("HumanoidRootPart")
    local hm  = ch:FindFirstChildOfClass("Humanoid")
    if not hrp or not hm then flingActive=false; return end
    local tc = target.Character; if not tc then flingActive=false; return end
    local th = tc:FindFirstChild("HumanoidRootPart"); if not th then flingActive=false; return end

    local oldCF = hrp.CFrame; local PW = F.FlingPower
    local saved = {}
    for _, p in pairs(ch:GetDescendants()) do
        if p:IsA("BasePart") then saved[p]=p.CanCollide; p.CanCollide=false end
    end
    hm:ChangeState(Enum.HumanoidStateType.Physics)

    local bv = Instance.new("BodyVelocity"); bv.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
    bv.Velocity=Vector3.zero; bv.Parent=hrp
    local bav = Instance.new("BodyAngularVelocity"); bav.MaxTorque=Vector3.new(math.huge,math.huge,math.huge)
    bav.AngularVelocity=Vector3.new(PW,PW,PW); bav.Parent=hrp

    for i=1,8 do
        if not th or not th.Parent then break end
        hrp.CFrame = th.CFrame * CFrame.new(0,-0.5,0)
        bv.Velocity = Vector3.new(0,PW,0)
        bav.AngularVelocity = Vector3.new(PW,PW,PW)
        hrp.RotVelocity = Vector3.new(PW,PW,PW)
        task.wait(0.015)
    end
    for i=1,30 do
        if not th or not th.Parent then break end
        hrp.CFrame = th.CFrame * CFrame.new(math.random(-1,1)*0.3,math.random(-1,1)*0.3,math.random(-1,1)*0.3)
            * CFrame.Angles(math.random()*math.pi*2,math.random()*math.pi*2,math.random()*math.pi*2)
        local rx,ry,rz = math.random()*2-1, math.random()+0.5, math.random()*2-1
        bv.Velocity = Vector3.new(rx,ry,rz).Unit * PW
        bav.AngularVelocity = Vector3.new((math.random()*2-1)*PW,(math.random()*2-1)*PW,(math.random()*2-1)*PW)
        hrp.RotVelocity = Vector3.new(math.random(-PW,PW),math.random(-PW,PW),math.random(-PW,PW))
        task.wait(0.01)
    end
    for i=1,5 do
        if not th or not th.Parent then break end
        hrp.CFrame = th.CFrame
        bv.Velocity = Vector3.new(math.random(-1,1)*PW, PW, math.random(-1,1)*PW)
        task.wait(0.01)
    end

    bv:Destroy(); bav:Destroy(); task.wait(0.05)
    hrp.Velocity = Vector3.zero; hrp.RotVelocity = Vector3.zero
    hrp.CFrame = oldCF; hm:ChangeState(Enum.HumanoidStateType.Running)
    for p, col in pairs(saved) do if p and p.Parent then p.CanCollide=col end end
    flingActive = false
end

