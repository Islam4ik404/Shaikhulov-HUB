-- ═══════════════════════ MM2 MEMORY ═══════════════════════

local MurdererMemory, SheriffMemory = {}, {}

local function GetRole(plr)
    local ch = plr.Character; if not ch then return "Мёртв", C.IW end
    local hm = ch:FindFirstChildOfClass("Humanoid")
    if hm and hm.Health <= 0 then
        MurdererMemory[plr.Name]=nil; SheriffMemory[plr.Name]=nil; return "Мёртв", C.IW
    end
    local function checkTool(src)
        for _, obj in pairs(src:GetChildren()) do
            if obj:IsA("Tool") then
                local n = obj.Name:lower()
                if n:find("knife") or n:find("нож") or n:find("murder") then
                    MurdererMemory[plr.Name]=true; return "🔪 УБИЙЦА", C.MR
                end
                if n:find("gun") or n:find("пистолет") or n:find("sheriff") then
                    SheriffMemory[plr.Name]=true; return "⭐ ШЕРИФ", C.SB
                end
            end
        end
    end
    local r1,c1 = checkTool(ch); if r1 then return r1,c1 end
    local bp = plr:FindFirstChild("Backpack")
    if bp then local r2,c2 = checkTool(bp); if r2 then return r2,c2 end end
    if MurdererMemory[plr.Name] then return "🔪 УБИЙЦА", C.MR end
    if SheriffMemory[plr.Name] then return "⭐ ШЕРИФ", C.SB end
    return "👤 Мирный", C.IW
end

