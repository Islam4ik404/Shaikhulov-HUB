        end
        Notify("🦅 Fly: "..(F.Fly.on and "✅ ON" or "❌ OFF"), F.Fly.on and C.Green or C.Red)

    elseif input.KeyCode == Enum.KeyCode.G then
        F.Noclip.on = not F.Noclip.on
        Notify("👻 Noclip: "..(F.Noclip.on and "✅ ON" or "❌ OFF"), F.Noclip.on and C.Green or C.Red)

