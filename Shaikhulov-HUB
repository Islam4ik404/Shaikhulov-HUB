RS.Heartbeat:Connect(function()
    local ch  = player.Character; if not ch then return end
    local hm  = ch:FindFirstChildOfClass("Humanoid")
    local hrp = ch:FindFirstChild("HumanoidRootPart")

    if F.Aimbot.on then
        local t = GetClosestInFOV()
        if t then camera.CFrame = CFrame.new(camera.CFrame.Position, t.Position) end
    end

    if F.InfJump.on and hm then hm.JumpPower = 60 end

    if F.Noclip.on then
        for _, p in pairs(ch:GetChildren()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end

    if F.Speed.on and hm and not F.Fly.on then hm.WalkSpeed = F.Speed.val end

    if F.RGB.on then
        local clr = Color3.fromHSV((tick()*80)%255/255, 1, 1)
        for _, p in pairs(ch:GetChildren()) do if p:IsA("BasePart") then p.Color=clr end end
    end

    if F.FlingAll.on then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= player then task.spawn(function() UltraFling(p) end) end
        end
    end

    if F.KillAura.on and hrp then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local th = p.Character:FindFirstChild("HumanoidRootPart")
                if th and (th.Position - hrp.Position).Magnitude <= F.KillAura.radius then
                    task.spawn(function() UltraFling(p) end)
                end
            end
        end
    end

    if F.FlingMurder.on and isMM2 and hrp then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local th = p.Character:FindFirstChild("HumanoidRootPart")
                if th and (th.Position - hrp.Position).Magnitude < 20 then
                    local role = GetRole(p)
                    if role:find("УБИЙЦА") then task.spawn(function() UltraFling(p) end) end
                end
            end
        end
    end

    if F.GunTP.on and isMM2 then GunTP() end
    if F.Fullbright.on then SetFullbright(true) end

    if F.FakeLag.on then
        local endT = tick() + 0.04
        while tick() < endT do end
    end
end)

